# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=development-only-change-me-32-bytes-minimum
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL
POSTGRES_DB=maktab
POSTGRES_USER=maktab
POSTGRES_PASSWORD=maktab-development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis and background jobs
REDIS_URL=redis://127.0.0.1:6379/0

# Local S3-compatible storage
AWS_ACCESS_KEY_ID=maktab
AWS_SECRET_ACCESS_KEY=maktab-development
AWS_STORAGE_BUCKET_NAME=maktab-local
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1

# Local email
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@maktab.local

# Renderer / Electron development
VITE_PLATFORM_API_URL=/api/v1
VITE_LOCAL_API_URL=/local-api/v1
MAKTAB_PLATFORM_API_URL=http://127.0.0.1:8000/api/v1

# Idempotent development seed credentials (never use in production)
MAKTAB_DEMO_PASSWORD=Maktab-Development-2026!
